# System Configuration
APP_NAME="Inventory & Order Management API"
DEBUG=True

# Database Connections
# For local running without Docker: postgresql://postgres:postgres@localhost:5432/inventory_db
# For Docker Compose: postgresql://postgres:postgres@db:5432/inventory_db
DATABASE_URL=postgresql://postgres:postgres@db:5432/inventory_db

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:80
